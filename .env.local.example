# Canonical site URL used for OG/Twitter/canonical/JSON-LD metadata.
# - Production (Vercel): set to https://www.echtalleskapot.be
# - Preview deploys: optionally set to the preview URL so canonical doesn't
#   compete with prod in Google; otherwise leave unset and previews will use
#   the prod URL as canonical.
# - Local development: leave unset (falls back to the prod URL in code).
NEXT_PUBLIC_SITE_URL=https://www.echtalleskapot.be
